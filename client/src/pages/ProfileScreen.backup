    <g transform="rotate(-24 18 15)">
      <path d="M4 7h28v5a3 3 0 0 0 0 6v5H4v-5a3 3 0 0 0 0-6z" fill="url(#pftk)" stroke="#fff1b4" strokeWidth="1.200" strokeLinejoin="round" />
